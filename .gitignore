# --- Personal health information -------------------------------------------
# Nothing containing your own health data belongs in this repo, especially if
# it is ever made public. Keep activity logs, lab results, and case-manager
# correspondence out of version control.
activity-log*
activity_log*
*activity-log*
personal/
private/
phi/
*.private.*

# --- OS ---------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Editors / IDEs ---------------------------------------------------------
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# --- Office / PDF scratch files ---------------------------------------------
~$*
*.tmp
*.bak
.~lock.*#

# --- Extraction / tooling scratch --------------------------------------------
# If you add scripts to pull text or images out of the PDFs, their output
# belongs here and stays untracked.
out/
build/
dist/
extracted/
*.log

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
.env
.pytest_cache/

# --- Node -------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
